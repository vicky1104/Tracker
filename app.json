{
  "expo": {
    "name": "HabitFlow",
    "slug": "habitflow",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "habitflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vicky.habitflow.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "appleTeamId": "MFMNLRV564"
    },
    "android": {
      "package": "com.vicky.habitflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F0F0E"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2A8C70",
          "defaultChannel": "habit-reminders"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Coral",
            "ios": "./assets/app-icons/coral.png",
            "android": {
              "foregroundImage": "./assets/app-icons/coral-foreground.png",
              "backgroundColor": "#FFE9E4"
            }
          },
          {
            "name": "Plum",
            "ios": "./assets/app-icons/plum.png",
            "android": {
              "foregroundImage": "./assets/app-icons/plum-foreground.png",
              "backgroundColor": "#FBE6F1"
            }
          },
          {
            "name": "Amber",
            "ios": "./assets/app-icons/amber.png",
            "android": {
              "foregroundImage": "./assets/app-icons/amber-foreground.png",
              "backgroundColor": "#FFF0DC"
            }
          },
          {
            "name": "Graphite",
            "ios": "./assets/app-icons/graphite.png",
            "android": {
              "foregroundImage": "./assets/app-icons/graphite-foreground.png",
              "backgroundColor": "#2B2E33"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9274150f-9ff2-416f-9135-a87af6e38e36"
      }
    }
  }
}
