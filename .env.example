# HabitFlow — client environment (copy to .env.local; never commit real values)
#
# Only EXPO_PUBLIC_* values are bundled into the app, so only put values here
# that are safe to ship publicly. Everything below is optional: with no values
# the app runs fully offline (local-first, no account, template planner).

# Supabase (auth, cloud sync, remote config, AI proxy). Anon key is public by design;
# data is protected by row-level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Enable the AI planner (requires Supabase + the `ai-plan` Edge Function).
EXPO_PUBLIC_AI_PLANNER_ENABLED=false

# RevenueCat public SDK keys (per platform) and entitlement identifier.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium

# Remote push (streak protection): your EAS project ID from `npx eas-cli@latest init`
# (alternatively stored in app.json → expo.extra.eas.projectId). Read by app.config.js.
EAS_PROJECT_ID=

# Legal / support links shown in Privacy and Premium screens.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets — set these with `supabase secrets set`, NOT in this file:
#   ANTHROPIC_API_KEY            (ai-plan)
#   ANTHROPIC_MODEL              (optional, default claude-opus-5-5)
#   REVENUECAT_SECRET_API_KEY    (revenuecat-webhook)
#   REVENUECAT_WEBHOOK_AUTH      (revenuecat-webhook, shared secret header)
#   REVENUECAT_ENTITLEMENT       (optional, default premium)
#   CRON_SECRET                  (streak-nudges; must equal Vault secret habitflow_cron_secret)
#   EXPO_ACCESS_TOKEN            (optional; only if Expo "enhanced push security" is on)
#
# Supabase dashboard (not env): Authentication → Providers → Google (Web client ID + secret)
# and Apple (Client IDs = your iOS bundle id), and URL Configuration → Redirect URLs:
#   habitflow://**   (dev/production builds)     exp://**   (Expo Go, development only)
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided to
# Edge Functions automatically by Supabase.
# ---------------------------------------------------------------------------
